{
  "name": "astro-renderer-foldkit",
  "version": "0.2.0",
  "private": true,
  "description": "A server-only Astro renderer for FoldKit components.",
  "bugs": {
    "url": "https://github.com/birbprophet/astro-renderer-foldkit/issues"
  },
  "license": "MIT",
  "author": "milkenjoyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birbprophet/astro-renderer-foldkit.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp pack"
  },
  "dependencies": {
    "astro": "7.2.7",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.157.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.20.0",
    "@types/node": "26.3.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  }
}
